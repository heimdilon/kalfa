      "icerik": "#[test]\nfn son_elemanlar_dogru_kesilir() {\n    assert_eq!(son_n_eleman(&[10, 20, 30, 40], 2), &[30, 40]);\n    assert_eq!(son_n_eleman(&[10, 20], 5), &[10, 20]);\n    assert_eq!(son_n_eleman(&[], 3), &[]);\n}\n"
